# worker.env.example — salin jadi worker.env lalu isi nilainya.
# File asli dibuat otomatis oleh setup-bridge.ps1 (dan jangan di-commit).

# --- bridge ---
# Mesin sendiri          : http://127.0.0.1:8765
# Mesin lain di tailnet  : http://100.x.y.z:8765
# Via MagicDNS           : http://nama-mesin.tailnet-anda.ts.net:8765
BRIDGE_URL=http://127.0.0.1:8765

# key role=worker — buat dengan:
#   python bridge.py keygen --role worker --label muse-worker
BRIDGE_WORKER_KEY=

# nama yang tercatat di lease
WORKER_LABEL=muse-worker

# --- upstream: siapa yang menyusun jawaban ---
# none            : echo placeholder (uji konektivitas saja)
# hermes          : jalankan Hermes CLI lokal (hermes -z "<prompt>")
# http://host/v1  : endpoint OpenAI-compatible lain
#                   PENTING: jangan arahkan ke bridge ini sendiri -> infinite loop
UPSTREAM=none
# UPSTREAM_KEY=
# UPSTREAM_MODEL=muse
# HERMES_BIN=C:\path\to\hermes.exe

# --- tuning ---
POLL_INTERVAL=3
REQUEST_TIMEOUT=120

# opsional: <queue>\pending untuk bangun instan saat ada job baru
# WATCH_DIR=D:\program\Muse-on-9Router-Hermes-Agent-ai\queue\pending
